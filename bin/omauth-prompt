#!/bin/bash

# Interactive and explicit setup helpers for omauth-prompt integrations.

set -euo pipefail
umask 077

readonly PLUGIN_ID="io.github.arthurwillers.omauth-prompt"
readonly CONFIG_PATH="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omauth-prompt"
readonly ASKPASS_ENV_PATH="$CONFIG_DIR/env"
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly PINENTRY_PATH="$script_dir/pinentry-omauth"
readonly ASKPASS_PATH="$script_dir/omauth-askpass"

usage() {
  cat <<'EOF'
Usage: omauth-prompt <command>

Commands:
  setup [options]    Interactive terminal setup wizard
  configure          Alias for setup
  setup-gpg          Configure GnuPG to use omauth-prompt's pinentry adapter
  setup-askpass      Configure SSH/Git and/or sudo askpass environment
  remove-gpg         Remove only omauth-prompt's GnuPG configuration
  remove-askpass     Remove the askpass environment file
  status             Show configured integrations
  doctor             Check dependencies and integration health

Setup options:
  --all       Configure GnuPG, SSH/Git askpass, and sudo askpass
  --gpg       Configure only GnuPG
  --askpass   Configure only SSH/Git askpass
  --sudo      Add sudo askpass to the environment file
EOF
}

backup_file() {
  local path="$1"
  local backup
  [[ -f "$path" ]] || return 0
  backup=$(mktemp "$path.bak.XXXXXXXX")
  cp -- "$path" "$backup"
  printf 'Backup: %s\n' "$backup"
}

backup_config() {
  backup_file "$CONFIG_PATH"
}

ensure_config_file() {
  mkdir -p -- "$(dirname -- "$CONFIG_PATH")"
  if [[ ! -e "$CONFIG_PATH" ]]; then
    : >"$CONFIG_PATH"
    chmod 600 "$CONFIG_PATH"
  fi
}

setup_gpg() {
  [[ -x "$PINENTRY_PATH" ]] || {
    printf 'Pinentry adapter is missing or not executable: %s\n' "$PINENTRY_PATH" >&2
    exit 1
  }

  ensure_config_file
  local line="pinentry-program $PINENTRY_PATH"

  if grep -Fqx "$line" "$CONFIG_PATH" 2>/dev/null; then
    printf 'GnuPG is already configured for omauth-prompt.\n'
  else
    if grep -Eq '^[[:space:]]*pinentry-program[[:space:]]+' "$CONFIG_PATH"; then
      printf 'gpg-agent.conf already contains another pinentry-program.\n' >&2
      printf 'Review it manually before choosing omauth-prompt: %s\n' "$CONFIG_PATH" >&2
      exit 2
    fi
    backup_config
    printf '\n# omauth-prompt (%s)\n%s\n' "$PLUGIN_ID" "$line" >>"$CONFIG_PATH"
    printf 'Configured GnuPG to use omauth-prompt.\n'
  fi

  gpgconf --kill gpg-agent
  printf 'Restarted gpg-agent.\n'
}

remove_gpg() {
  local line="pinentry-program $PINENTRY_PATH"
  if [[ ! -f "$CONFIG_PATH" ]] || ! grep -Fqx "$line" "$CONFIG_PATH" 2>/dev/null; then
    printf 'omauth-prompt is not configured in %s.\n' "$CONFIG_PATH"
    gpgconf --kill gpg-agent
    return 0
  fi

  backup_config
  local temporary
  temporary=$(mktemp)
  awk -v line="$line" '$0 != line' "$CONFIG_PATH" >"$temporary"
  chmod --reference="$CONFIG_PATH" "$temporary"
  mv -- "$temporary" "$CONFIG_PATH"
  gpgconf --kill gpg-agent
  printf 'Removed omauth-prompt from GnuPG configuration.\n'
  printf 'Restarted gpg-agent.\n'
}

askpass_env_value() {
  printf '%q' "$ASKPASS_PATH"
}

askpass_env_has() {
  local variable="$1"
  local value
  value=$(askpass_env_value)
  [[ -f "$ASKPASS_ENV_PATH" ]] \
    && grep -Fqx "export $variable=$value" "$ASKPASS_ENV_PATH"
}

write_askpass_env() {
  local enable_ssh_git="${1:-false}"
  local enable_sudo="${2:-false}"
  local ssh_git_enabled="$enable_ssh_git"
  local sudo_enabled="$enable_sudo"
  local temporary

  if [[ "$ssh_git_enabled" != "true" ]] && askpass_env_has SSH_ASKPASS; then
    ssh_git_enabled=true
  fi
  if [[ "$sudo_enabled" != "true" ]] && askpass_env_has SUDO_ASKPASS; then
    sudo_enabled=true
  fi

  if [[ "$ssh_git_enabled" != "true" && "$sudo_enabled" != "true" ]]; then
    remove_askpass
    return 0
  fi

  mkdir -p -- "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  backup_file "$ASKPASS_ENV_PATH"
  temporary=$(mktemp "$CONFIG_DIR/env.XXXXXXXX")
  {
    printf '# Generated by %s. Source this file in your shell.\n' "$PLUGIN_ID"
    printf '# It contains paths and environment settings, never passwords.\n'
    if [[ "$ssh_git_enabled" == "true" ]]; then
      printf 'export SSH_ASKPASS=%q\n' "$ASKPASS_PATH"
      printf 'export SSH_ASKPASS_REQUIRE=force\n'
      printf 'export GIT_ASKPASS=%q\n' "$ASKPASS_PATH"
      printf 'export GIT_TERMINAL_PROMPT=0\n'
    fi
    if [[ "$sudo_enabled" == "true" ]]; then
      printf 'export SUDO_ASKPASS=%q\n' "$ASKPASS_PATH"
    fi
  } >"$temporary"
  chmod 600 "$temporary"
  mv -- "$temporary" "$ASKPASS_ENV_PATH"
  printf 'Wrote askpass environment: %s\n' "$ASKPASS_ENV_PATH"
  printf 'Enable it in this shell with: source %q\n' "$ASKPASS_ENV_PATH"
}

setup_askpass() {
  local mode="${1:-all}"
  local enable_ssh_git=false
  local enable_sudo=false

  case "$mode" in
    all)
      enable_ssh_git=true
      enable_sudo=true
      ;;
    ssh-git)
      enable_ssh_git=true
      ;;
    sudo)
      enable_sudo=true
      ;;
    *)
      printf 'Unknown askpass mode: %s\n' "$mode" >&2
      return 2
      ;;
  esac

  [[ -x "$ASKPASS_PATH" ]] || {
    printf 'Askpass adapter is missing or not executable: %s\n' "$ASKPASS_PATH" >&2
    return 1
  }
  write_askpass_env "$enable_ssh_git" "$enable_sudo"
}

remove_askpass() {
  if [[ ! -f "$ASKPASS_ENV_PATH" ]]; then
    printf 'omauth-prompt askpass is not configured.\n'
    return 0
  fi

  backup_file "$ASKPASS_ENV_PATH"
  rm -- "$ASKPASS_ENV_PATH"
  rmdir -- "$CONFIG_DIR" 2>/dev/null || true
  printf 'Removed askpass environment configuration.\n'
}

gpg_status() {
  if [[ -f "$CONFIG_PATH" ]] \
    && grep -Fqx "pinentry-program $PINENTRY_PATH" "$CONFIG_PATH" 2>/dev/null; then
    printf 'configured'
  else
    printf 'not configured'
  fi
}

ssh_git_status() {
  if askpass_env_has SSH_ASKPASS \
    && askpass_env_has GIT_ASKPASS \
    && grep -Fqx 'export SSH_ASKPASS_REQUIRE=force' "$ASKPASS_ENV_PATH" \
    && grep -Fqx 'export GIT_TERMINAL_PROMPT=0' "$ASKPASS_ENV_PATH"; then
    printf 'configured'
  else
    printf 'not configured'
  fi
}

sudo_status() {
  if askpass_env_has SUDO_ASKPASS; then
    printf 'configured'
  else
    printf 'not configured'
  fi
}

status() {
  printf 'GnuPG / PGP: %s\n' "$(gpg_status)"
  printf 'SSH / Git askpass: %s\n' "$(ssh_git_status)"
  printf 'Sudo askpass: %s\n' "$(sudo_status)"
}

doctor() {
  local failures=0
  local dependency

  printf 'omauth-prompt doctor\n\n'
  for dependency in gpgconf jq python3 gum; do
    if command -v "$dependency" >/dev/null 2>&1; then
      printf '✓ %-8s available\n' "$dependency"
    else
      printf '✗ %-8s missing\n' "$dependency"
      failures=$((failures + 1))
    fi
  done

  if [[ -x "$PINENTRY_PATH" ]]; then
    printf '✓ %-8s available\n' 'pinentry'
  else
    printf '✗ %-8s missing\n' 'pinentry'
    failures=$((failures + 1))
  fi

  if [[ -x "$ASKPASS_PATH" ]]; then
    printf '✓ %-8s available\n' 'askpass'
  else
    printf '✗ %-8s missing\n' 'askpass'
    failures=$((failures + 1))
  fi

  printf '\n'
  status

  if [[ -f "$CONFIG_PATH" ]] \
    && grep -Eq '^[[:space:]]*pinentry-program[[:space:]]+' "$CONFIG_PATH" \
    && ! grep -Fqx "pinentry-program $PINENTRY_PATH" "$CONFIG_PATH"; then
    printf '\n! gpg-agent.conf contains another pinentry-program: %s\n' "$CONFIG_PATH"
    failures=$((failures + 1))
  fi

  return "$failures"
}

configure_selected() {
  local enable_gpg="$1"
  local enable_ssh_git="$2"
  local enable_sudo="$3"
  local interactive="${4:-false}"

  if [[ "$interactive" == "true" ]]; then
    gum style \
      --border rounded \
      --padding '1 2' \
      --border-foreground 99 \
      'omauth-prompt' 'Configure authentication integrations'
    if ! gum confirm 'Apply the selected integrations?'; then
      printf 'Setup cancelled.\n'
      return 0
    fi
  fi

  if [[ "$enable_gpg" == "true" ]]; then
    setup_gpg
  fi
  if [[ "$enable_ssh_git" == "true" && "$enable_sudo" == "true" ]]; then
    setup_askpass all
  elif [[ "$enable_ssh_git" == "true" ]]; then
    setup_askpass ssh-git
  elif [[ "$enable_sudo" == "true" ]]; then
    setup_askpass sudo
  fi

  printf '\n'
  status
}

interactive_setup() {
  local selections
  local selection
  local enable_gpg=false
  local enable_ssh_git=false
  local enable_sudo=false

  [[ -t 0 && -t 1 ]] || {
    printf 'Interactive setup requires a terminal. Use setup --all or a specific option.\n' >&2
    return 1
  }
  command -v gum >/dev/null 2>&1 || {
    printf 'The interactive setup requires gum, which is included with Omarchy.\n' >&2
    return 1
  }

  if ! selections=$(gum choose \
    --no-limit \
    --height 8 \
    --header 'Select integrations (Space to select, Enter to continue)' \
    'GnuPG / PGP' \
    'SSH / Git askpass' \
    'Sudo askpass'); then
    printf 'Setup cancelled.\n'
    return 0
  fi

  [[ -n "$selections" ]] || {
    printf 'No integrations selected.\n'
    return 0
  }

  while IFS= read -r selection; do
    case "$selection" in
      'GnuPG / PGP') enable_gpg=true ;;
      'SSH / Git askpass') enable_ssh_git=true ;;
      'Sudo askpass') enable_sudo=true ;;
    esac
  done <<<"$selections"

  configure_selected "$enable_gpg" "$enable_ssh_git" "$enable_sudo" true
}

configure() {
  local option
  local enable_gpg=false
  local enable_ssh_git=false
  local enable_sudo=false

  if (( $# == 0 )); then
    interactive_setup
    return
  fi

  while (( $# > 0 )); do
    option="$1"
    shift
    case "$option" in
      --all)
        enable_gpg=true
        enable_ssh_git=true
        enable_sudo=true
        ;;
      --gpg)
        enable_gpg=true
        ;;
      --askpass)
        enable_ssh_git=true
        ;;
      --sudo)
        enable_sudo=true
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        printf 'Unknown setup option: %s\n' "$option" >&2
        usage >&2
        return 2
        ;;
    esac
  done

  if [[ "$enable_gpg" != "true" && "$enable_ssh_git" != "true" && "$enable_sudo" != "true" ]]; then
    printf 'Choose at least one setup option.\n' >&2
    return 2
  fi
  configure_selected "$enable_gpg" "$enable_ssh_git" "$enable_sudo"
}

case "${1:-}" in
  setup|configure) shift; configure "$@" ;;
  setup-gpg) setup_gpg ;;
  setup-askpass) setup_askpass "${2:-all}" ;;
  remove-gpg) remove_gpg ;;
  remove-askpass) remove_askpass ;;
  status) status ;;
  doctor) doctor ;;
  -h|--help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
